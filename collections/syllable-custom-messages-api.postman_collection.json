  "item": [
    {
      "id": "cc2e4df1-7349-432d-8ad2-2de410d5088c",
      "name": "custom_messages",
      "description": {
        "content": "Operations related to custom message configuration.           A custom message is a pre-configured message delivered by an agent as a greeting at the           beginning of a conversation. Multiple agents can use the same custom mesasage. A custom           message has one or more rules defined, which allow for different messages to be           dynamically selected and delivered at runtime based on the current time and either           date or day of the week. For more information, see           [Console docs](https://docs.syllable.ai/Resources/Messages).",
        "type": "text/plain"
      },
