{
  "opencollection": "1.0.0",
  "info": {
    "name": "SyllableSDK Data Sources API",
    "version": "0.0.3"
  },
  "items": [
    {
      "info": {
        "name": "data_sources",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Data Sources",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.syllable.cloud/api/v1/data_sources/",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "The page number from which to start (0-based)"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "The maximum number of items to return"
              },
              {
                "name": "search_fields",
                "value": "",
                "type": "query",
                "description": "String names of fields to search. Correspond by index to search field values"
              },
              {
                "name": "search_field_values",
                "value": "",
                "type": "query",
                "description": "Values of fields to search. Correspond by index to search fields. Unless field name contains \"list\", an individual search field value cannot be a list"
              },
              {
                "name": "order_by",
                "value": "",
                "type": "query",
                "description": "The field whose value should be used to order the results"
              },
              {
                "name": "order_by_direction",
                "value": "",
                "type": "query",
                "description": "The direction in which to order the results"
              },
              {
                "name": "fields",
                "value": "",
                "type": "query",
                "description": "The fields to include in the response"
              },
              {
                "name": "start_datetime",
                "value": "",
                "type": "query",
                "description": "The start datetime for filtering results"
              },
              {
                "name": "end_datetime",
                "value": "",
                "type": "query",
                "description": "The end datetime for filtering results"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Syllable-API-Key",
              "value": "{{Syllable-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Fetch metadata about all data sources, not including their text."
        },
        {
          "info": {
            "name": "Create Data Source",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.syllable.cloud/api/v1/data_sources/",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Syllable-API-Key",
              "value": "{{Syllable-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Create a new data source."
        },
        {
          "info": {
            "name": "Update Data Source",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.syllable.cloud/api/v1/data_sources/",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Syllable-API-Key",
              "value": "{{Syllable-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Update an existing data source."
        },
        {
          "info": {
            "name": "Get Data Source",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.syllable.cloud/api/v1/data_sources/:data_source_id",
            "params": [
              {
                "name": "data_source_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Syllable-API-Key",
              "value": "{{Syllable-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Fetch a given data source, including its text."
        },
        {
          "info": {
            "name": "Delete Data Source",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.syllable.cloud/api/v1/data_sources/:data_source_id",
            "params": [
              {
                "name": "data_source_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "reason",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Syllable-API-Key",
              "value": "{{Syllable-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Delete a given data source."
        }
      ]
    }
  ],
  "bundled": true
}