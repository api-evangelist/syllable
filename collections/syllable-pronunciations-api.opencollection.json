{
  "opencollection": "1.0.0",
  "info": {
    "name": "SyllableSDK Pronunciations API",
    "version": "0.0.3"
  },
  "items": [
    {
      "info": {
        "name": "pronunciations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Pronunciations Dictionary",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.syllable.cloud/api/v1/pronunciations",
            "auth": {
              "type": "apikey",
              "key": "Syllable-API-Key",
              "value": "{{Syllable-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Get Pronunciations Dictionary"
        },
        {
          "info": {
            "name": "Get Pronunciations Metadata",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.syllable.cloud/api/v1/pronunciations/metadata",
            "auth": {
              "type": "apikey",
              "key": "Syllable-API-Key",
              "value": "{{Syllable-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Get Pronunciations Metadata"
        },
        {
          "info": {
            "name": "Download Pronunciations Csv",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.syllable.cloud/api/v1/pronunciations/csv",
            "auth": {
              "type": "apikey",
              "key": "Syllable-API-Key",
              "value": "{{Syllable-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Download Pronunciations Csv"
        },
        {
          "info": {
            "name": "Upload Pronunciations Csv",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.syllable.cloud/api/v1/pronunciations/csv",
            "body": {
              "type": "multipart-form",
              "data": []
            },
            "auth": {
              "type": "apikey",
              "key": "Syllable-API-Key",
              "value": "{{Syllable-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Upload Pronunciations Csv"
        },
        {
          "info": {
            "name": "Delete Pronunciations Dictionary",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.syllable.cloud/api/v1/pronunciations/csv",
            "auth": {
              "type": "apikey",
              "key": "Syllable-API-Key",
              "value": "{{Syllable-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Delete Pronunciations Dictionary"
        }
      ]
    }
  ],
  "bundled": true
}