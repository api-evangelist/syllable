          "http": {
            "method": "POST",
            "url": "https://api.syllable.cloud/api/v1/users/:user_email/send_email",
            "params": [
              {
                "name": "user_email",
                "value": "",
                "type": "path"
              },
              {
                "name": "skip_auth",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Syllable-API-Key",
              "value": "{{Syllable-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Send a welcome email to a user."
