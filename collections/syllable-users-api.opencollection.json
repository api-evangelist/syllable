          "http": {
            "method": "GET",
            "url": "https://api.syllable.cloud/api/v1/users/:user_email",
            "params": [
              {
                "name": "user_email",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Syllable-API-Key",
              "value": "{{Syllable-API-Key}}",
              "placement": "header"
