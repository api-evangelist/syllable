{
  "opencollection": "1.0.0",
  "info": {
    "name": "SyllableSDK Sessions API",
    "version": "0.0.3"
  },
  "items": [
    {
      "info": {
        "name": "sessions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Sessions List",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.syllable.cloud/api/v1/sessions/",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "The page number from which to start (0-based)"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "The maximum number of items to return"
              },
              {
                "name": "search_fields",
                "value": "",
                "type": "query",
                "description": "String names of fields to search. Correspond by index to search field values"
              },
              {
                "name": "search_field_values",
                "value": "",
                "type": "query",
                "description": "Values of fields to search. Correspond by index to search fields. Unless field name contains \"list\", an individual search field value cannot be a list"
              },
              {
                "name": "order_by",
                "value": "",
                "type": "query",
                "description": "The field whose value should be used to order the results"
              },
              {
                "name": "order_by_direction",
                "value": "",
                "type": "query",
                "description": "The direction in which to order the results"
              },
              {
                "name": "fields",
                "value": "",
                "type": "query",
                "description": "The fields to include in the response"
              },
              {
                "name": "start_datetime",
                "value": "",
                "type": "query",
                "description": "The start datetime for filtering results"
              },
              {
                "name": "end_datetime",
                "value": "",
                "type": "query",
                "description": "The end datetime for filtering results"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Syllable-API-Key",
              "value": "{{Syllable-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Sessions List"
        },
        {
          "info": {
            "name": "Get A Single Session By Id",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.syllable.cloud/api/v1/sessions/:session_id",
            "params": [
              {
                "name": "session_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Syllable-API-Key",
              "value": "{{Syllable-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Get A Single Session By Id"
        },
        {
          "info": {
            "name": "Generate Recording Urls",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.syllable.cloud/api/v1/sessions/recording/:session_id",
            "params": [
              {
                "name": "session_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Syllable-API-Key",
              "value": "{{Syllable-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Generate Recording Urls"
        },
        {
          "info": {
            "name": "Stream Recording",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.syllable.cloud/api/v1/sessions/recording/stream",
            "params": [
              {
                "name": "token",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Syllable-API-Key",
              "value": "{{Syllable-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Stream Recording"
        }
      ]
    }
  ],
  "bundled": true
}