{
  "opencollection": "1.0.0",
  "info": {
    "name": "SyllableSDK Prompts API",
    "version": "0.0.3"
  },
  "items": [
    {
      "info": {
        "name": "prompts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Prompt List",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.syllable.cloud/api/v1/prompts/",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "The page number from which to start (0-based)"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "The maximum number of items to return"
              },
              {
                "name": "search_fields",
                "value": "",
                "type": "query",
                "description": "String names of fields to search. Correspond by index to search field values"
              },
              {
                "name": "search_field_values",
                "value": "",
                "type": "query",
                "description": "Values of fields to search. Correspond by index to search fields. Unless field name contains \"list\", an individual search field value cannot be a list"
              },
              {
                "name": "order_by",
                "value": "",
                "type": "query",
                "description": "The field whose value should be used to order the results"
              },
              {
                "name": "order_by_direction",
                "value": "",
                "type": "query",
                "description": "The direction in which to order the results"
              },
              {
                "name": "fields",
                "value": "",
                "type": "query",
                "description": "The fields to include in the response"
              },
              {
                "name": "start_datetime",
                "value": "",
                "type": "query",
                "description": "The start datetime for filtering results"
              },
              {
                "name": "end_datetime",
                "value": "",
                "type": "query",
                "description": "The end datetime for filtering results"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Syllable-API-Key",
              "value": "{{Syllable-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "List the existing prompts"
        },
        {
          "info": {
            "name": "Create Prompt",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.syllable.cloud/api/v1/prompts/",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Syllable-API-Key",
              "value": "{{Syllable-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Create a new prompt"
        },
        {
          "info": {
            "name": "Update Prompt",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.syllable.cloud/api/v1/prompts/",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Syllable-API-Key",
              "value": "{{Syllable-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Update an existing prompt"
        },
        {
          "info": {
            "name": "Get Prompt By Id",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.syllable.cloud/api/v1/prompts/:prompt_id",
            "params": [
              {
                "name": "prompt_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Syllable-API-Key",
              "value": "{{Syllable-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Get a prompt by ID"
        },
        {
          "info": {
            "name": "Delete Prompt",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.syllable.cloud/api/v1/prompts/:prompt_id",
            "params": [
              {
                "name": "prompt_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "reason",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Syllable-API-Key",
              "value": "{{Syllable-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Delete a prompt"
        },
        {
          "info": {
            "name": "Get Prompt History",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.syllable.cloud/api/v1/prompts/:prompt_id/history",
            "params": [
              {
                "name": "prompt_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Syllable-API-Key",
              "value": "{{Syllable-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Get a list of historical versions of a prompt by its ID"
        },
        {
          "info": {
            "name": "Get Supported Llm Configs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.syllable.cloud/api/v1/prompts/llms/supported",
            "auth": {
              "type": "apikey",
              "key": "Syllable-API-Key",
              "value": "{{Syllable-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Get supported LLM configs."
        }
      ]
    }
  ],
  "bundled": true
}