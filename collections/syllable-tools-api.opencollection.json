{
  "opencollection": "1.0.0",
  "info": {
    "name": "SyllableSDK Tools API",
    "version": "0.0.3"
  },
  "items": [
    {
      "info": {
        "name": "tools",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Tool List",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.syllable.cloud/api/v1/tools/",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "The page number from which to start (0-based)"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "The maximum number of items to return"
              },
              {
                "name": "search_fields",
                "value": "",
                "type": "query",
                "description": "String names of fields to search. Correspond by index to search field values"
              },
              {
                "name": "search_field_values",
                "value": "",
                "type": "query",
                "description": "Values of fields to search. Correspond by index to search fields. Unless field name contains \"list\", an individual search field value cannot be a list"
              },
              {
                "name": "order_by",
                "value": "",
                "type": "query",
                "description": "The field whose value should be used to order the results"
              },
              {
                "name": "order_by_direction",
                "value": "",
                "type": "query",
                "description": "The direction in which to order the results"
              },
              {
                "name": "fields",
                "value": "",
                "type": "query",
                "description": "The fields to include in the response"
              },
              {
                "name": "start_datetime",
                "value": "",
                "type": "query",
                "description": "The start datetime for filtering results"
              },
              {
                "name": "end_datetime",
                "value": "",
                "type": "query",
                "description": "The end datetime for filtering results"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Syllable-API-Key",
              "value": "{{Syllable-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "List the existing tools"
        },
        {
          "info": {
            "name": "Create Tool",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.syllable.cloud/api/v1/tools/",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Syllable-API-Key",
              "value": "{{Syllable-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Create a new tool"
        },
        {
          "info": {
            "name": "Update Tool",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.syllable.cloud/api/v1/tools/",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Syllable-API-Key",
              "value": "{{Syllable-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Update an existing tool"
        },
        {
          "info": {
            "name": "Tool History",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.syllable.cloud/api/v1/tools/:tool_id/history",
            "params": [
              {
                "name": "tool_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number (0-based)"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Items per page"
              },
              {
                "name": "order_by_direction",
                "value": "",
                "type": "query",
                "description": "Sort by oldest first (asc) or newest first (desc). Version 1 is always the oldest."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Syllable-API-Key",
              "value": "{{Syllable-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Get version history for a tool."
        },
        {
          "info": {
            "name": "Tool Info",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.syllable.cloud/api/v1/tools/:tool_name",
            "params": [
              {
                "name": "tool_name",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Syllable-API-Key",
              "value": "{{Syllable-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Get the details of a specific tool"
        },
        {
          "info": {
            "name": "Delete Tool",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.syllable.cloud/api/v1/tools/:tool_name",
            "params": [
              {
                "name": "tool_name",
                "value": "",
                "type": "path"
              },
              {
                "name": "reason",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Syllable-API-Key",
              "value": "{{Syllable-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Delete a tool."
        }
      ]
    }
  ],
  "bundled": true
}