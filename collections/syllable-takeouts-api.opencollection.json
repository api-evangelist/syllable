          "http": {
            "method": "POST",
            "url": "https://api.syllable.cloud/api/v1/takeouts/create",
            "auth": {
              "type": "apikey",
              "key": "Syllable-API-Key",
              "value": "{{Syllable-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Create Takeout"
        },
        {
          "info": {
            "name": "Get Takeout",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.syllable.cloud/api/v1/takeouts/get/:job_id",
            "params": [
              {
                "name": "job_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Syllable-API-Key",
              "value": "{{Syllable-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Get Takeout"
        },
        {
          "info": {
            "name": "Get File",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.syllable.cloud/api/v1/takeouts/get/:job_id/file/:file_name",
            "params": [
              {
                "name": "job_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "file_name",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Syllable-API-Key",
              "value": "{{Syllable-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Get File"
        }
      ]
    }
  ],
  "bundled": true
